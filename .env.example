# Configurações do Django
DEBUG=True
SECRET_KEY=django-insecure-agente01-personal-assistant-secret-key-change-in-production
ALLOWED_HOSTS=*

# Nuvem de Dados (Opcional - se vazio, utiliza SQLite local)
# Exemplo Supabase / Neon PostgreSQL:
# DATABASE_URL=postgresql://postgres:senha@db.exemplo.supabase.co:5432/postgres
DATABASE_URL=

# Google Gemini AI (Google AI Studio - Gratuito)
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Localização padrão para previsão do tempo
DEFAULT_CITY=Itobi, SP
DEFAULT_LAT=-21.7336
DEFAULT_LON=-46.9744
